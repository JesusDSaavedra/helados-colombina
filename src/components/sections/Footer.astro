---
import { Icon } from 'astro-icon/components';
import Logo from '../ui/Logo.astro';
import Wave from '../ui/Wave.astro';
import { socials } from '../../data/content';

const year = new Date().getFullYear();
---

<footer id="contacto" class="relative bg-brand-cream">
  <Wave fill="#243587" class="-mb-px" />
  <div class="relative overflow-hidden bg-brand-blue text-white">
    <div
      class="absolute -right-10 bottom-6 size-32 rounded-[60%_40%_30%_70%/60%_30%_70%_40%] bg-brand-red"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-8 md:grid-cols-3 md:items-center">
      <div class="flex justify-center md:justify-start">
        <Logo />
      </div>

      <div class="text-center">
        <p class="text-sm font-semibold">Síguenos en nuestras redes</p>
        <ul class="mt-3 flex justify-center gap-3">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="btn btn-circle btn-sm border-0 bg-white text-brand-blue transition-transform hover:scale-110 hover:bg-brand-red hover:text-white"
                >
                  <Icon name={social.icon} class="size-4" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <form class="md:border-l md:border-white/20 md:pl-10" id="newsletter-form" novalidate>
        <label for="newsletter-email" class="text-sm font-semibold">
          Suscríbete y no te pierdas nuestras novedades
        </label>
        <div class="join mt-3 w-full max-w-sm">
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="Tu correo electrónico"
            class="input join-item w-full border-0 text-brand-blue"
          />
          <button type="submit" class="btn btn-secondary join-item">Enviar</button>
        </div>
        <p class="mt-2 min-h-5 text-xs text-white/80" role="status" aria-live="polite" data-newsletter-status></p>
      </form>
    </div>

    <p class="relative pb-6 text-center text-xs text-white/60">© {year} Colombina. Todos los derechos reservados.</p>
  </div>
</footer>

<script>
  // Front-end only feedback. Wire this to a real newsletter provider when available.
  function setupNewsletter() {
    const form = document.querySelector<HTMLFormElement>('#newsletter-form');
    const status = form?.querySelector<HTMLElement>('[data-newsletter-status]');
    if (!form || !status) return;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[type="email"]');
      if (!input?.checkValidity()) {
        status.textContent = 'Ingresa un correo válido.';
        input?.focus();
        return;
      }
      status.textContent = '¡Gracias! Pronto recibirás nuestras novedades.';
      form.reset();
    });
  }

  document.addEventListener('astro:page-load', setupNewsletter);
</script>
