---
import { Icon } from 'astro-icon/components';
import ImageFrame from '../ui/ImageFrame.astro';
import Sparkle from '../ui/Sparkle.astro';
import { flavors, products } from '../../data/content';
---

<section id="helados" class="relative bg-brand-cream py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-8">
    <header class="text-center" data-reveal>
      <h2 class="relative inline-flex items-start gap-2 text-4xl font-extrabold tracking-tight md:text-5xl">
        <Sparkle class="-mt-4 hidden size-8 text-brand-blue sm:block" />
        {products.title}
        <Sparkle class="-mt-4 size-8 text-brand-red" flip />
      </h2>
      <p class="mt-3 text-lg font-medium text-brand-blue/80">{products.subtitle}</p>
    </header>

    <ul class="mt-12 grid grid-cols-2 gap-6 lg:grid-cols-4">
      {
        flavors.map((flavor, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 90}ms`}>
            <article class="group card h-full bg-white text-center shadow-sm ring-1 ring-brand-blue/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-brand-blue/10">
              <figure class="aspect-square overflow-hidden rounded-t-box bg-white">
                <ImageFrame
                  image={flavor.image}
                  fit="contain"
                  class="p-6 transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-3"
                  placeholderLabel={`Sabor: ${flavor.name} (prompt #2)`}
                />
              </figure>
              <div class="card-body items-center gap-1 p-5">
                <h3 class="card-title text-xl font-bold">{flavor.name}</h3>
                <p class="text-sm text-brand-blue/70">{flavor.description}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 text-center" data-reveal>
      <a
        href={products.cta.href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline btn-primary rounded-full border-2 px-8 transition-transform hover:scale-105"
      >
        {products.cta.label}
        <Icon name="lucide:chevron-right" class="size-5" />
      </a>
    </div>
  </div>
</section>
