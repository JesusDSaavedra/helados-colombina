---
import { brandLogo } from '../../data/content';
import { asset } from '../../lib/asset';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a
  href="#inicio"
  aria-label="Colombina, ir al inicio"
  class:list={['inline-flex items-center transition-transform duration-300 hover:-rotate-2 hover:scale-105', className]}
  transition:name="brand-logo"
>
  {
    brandLogo.src ? (
      /* The official file already includes its white banner shape for dark backgrounds. */
      <img
        src={asset(brandLogo.src)}
        alt={brandLogo.alt}
        width={brandLogo.width}
        height={brandLogo.height}
        class="h-16 w-auto drop-shadow-lg md:h-20"
      />
    ) : (
      <span class="flex items-center gap-2 rounded-2xl bg-white px-4 py-2 shadow-lg">
        <span class="font-script text-2xl text-brand-blue md:text-3xl">Colombina</span>
        <span class="block size-5 rotate-45 rounded-[4px] bg-brand-red" aria-hidden="true" />
      </span>
    )
  }
</a>
