---
import { brandLogo } from '../../data/content';
import { asset } from '../../lib/asset';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a
  href="#inicio"
  aria-label="Colombina, ir al inicio"
  class:list={[
    'inline-flex items-center rounded-2xl bg-white px-4 py-2 shadow-lg shadow-brand-blue-dark/20 transition-transform duration-300 hover:-rotate-2 hover:scale-105',
    className,
  ]}
  transition:name="brand-logo"
>
  {
    brandLogo.src ? (
      <img src={asset(brandLogo.src)} alt={brandLogo.alt} width={brandLogo.width} height={brandLogo.height} class="h-9 w-auto md:h-11" />
    ) : (
      /* Temporary wordmark. Replace with the official Colombina logo file. */
      <span class="flex items-center gap-2">
        <span class="font-script text-2xl text-brand-blue md:text-3xl">Colombina</span>
        <span class="block size-5 rotate-45 rounded-[4px] bg-brand-red" aria-hidden="true" />
      </span>
    )
  }
</a>
